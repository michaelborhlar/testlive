# Copy to .env and load it into your shell (or set these in your host's
# environment panel) before running in production.

# --- Core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=exams.example.com,www.exams.example.com
DJANGO_TIME_ZONE=Africa/Lagos

# --- Where the React app is served from -------------------------------
FRONTEND_ORIGINS=https://exams.example.com
CSRF_TRUSTED_ORIGINS=https://exams.example.com

# --- HTTPS (behind nginx / Render / Railway) --------------------------
USE_HTTPS=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# --- PostgreSQL (leave unset to keep SQLite) --------------------------
# DB_NAME=graduate_exams
# DB_USER=exams
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Question import --------------------------------------------------
# auto      = use a local Ollama model if one is running, else the offline parser
# heuristic = always use the offline parser
# ollama    = always use Ollama
AI_IMPORT_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
AI_IMPORT_TIMEOUT=120
